# EduCopilot M6 — root .gitignore
# Created during the pre-GitHub cleanup (see docs/M6_REPOSITORY_CLEANUP_AUDIT.md).
# Git has not been initialized yet; this file takes effect once it is.

# ---------------------------------------------------------------------------
# Secrets — never commit real values, only *.example templates
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.docker.example
*.pem

# ---------------------------------------------------------------------------
# Python build/test caches (regenerated automatically)
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Node / Next.js (team4c already has its own .gitignore covering this;
# kept here too in case the root becomes the effective git root for a tool
# that doesn't descend into nested .gitignore files)
# ---------------------------------------------------------------------------
node_modules/
.next/
*.tsbuildinfo
next-env.d.ts
.local-uploads/

# ---------------------------------------------------------------------------
# Captured/ad-hoc debug output (Phase 5L: re-added — present in the original
# cleanup audit's own recommendation but missing from this file; no tracked
# or committed *.log file exists anywhere in the repository, verified before
# adding this)
# ---------------------------------------------------------------------------
*.log

# ---------------------------------------------------------------------------
# IDE / OS artifacts
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Non-canonical disposable project-copy directory (exact name only). Kept
# locally, excluded from Git — see docs/m6-product-validation-isolation-
# environment.md for why it exists. The four old team4a/team4b backup
# snapshots that used to be listed here were deleted on 2026-09-28 (see
# docs/DOCUMENTATION_CLEANUP_2026-09-28.md); their history is preserved in
# docs/history/M6_REPOSITORY_CLEANUP_AUDIT.md and
# docs/history/REPOSITORY_CLEANUP_REPORT.md.
# ---------------------------------------------------------------------------
/team4c-validation/

# ---------------------------------------------------------------------------
# Tool-local session state (Claude Code) — not project content
# ---------------------------------------------------------------------------
/.claude/
